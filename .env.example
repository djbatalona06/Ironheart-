#   DeepSeek: AI_API_KEY=...      AI_BASE_URL=https://api.deepseek.com   AI_MODEL=deepseek-v4-flash
#   Ollama (local dev only): AI_API_KEY=ollama  AI_BASE_URL=http://localhost:11434/v1  AI_MODEL=<pulled model>
# A custom AI_BASE_URL requires AI_MODEL.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
