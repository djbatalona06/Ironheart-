# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
e2e/out/

# local Supabase CLI state (config.toml and migrations stay tracked)
supabase/.temp/
supabase/.branches/

# test output
/test-results/
/playwright-report/
*.log

# AI provider comparison output (may contain model replies; never commit)
scripts/out/
ai-compare-results*.json

# editors / OS
.idea/
.vscode/*
!.vscode/extensions.json
Thumbs.db

# local agent settings and plans
.claude/settings.local.json
.claude/plans/
